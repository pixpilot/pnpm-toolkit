# Set the repository to show as TypeScript rather than JS in GitHub
*.ts linguist-language=TypeScript

# Exclude JavaScript config files from language detection
*.config.js linguist-detectable=false
*.config.mjs linguist-detectable=false
eslint.config.mjs linguist-detectable=false
prettier.config.js linguist-detectable=false
jest.config.mjs linguist-detectable=false

# Exclude generated and build files
dist/* linguist-generated=true
coverage/* linguist-generated=true
node_modules/* linguist-vendored=true

# Exclude lock files and other non-source files
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true

# >>> eol-policy (managed by _tools/eol/apply-gitattributes.mjs) >>>
# Normalise text to LF in the repository AND in the working tree, on every OS.
# This overrides core.autocrlf and core.eol, so the result no longer depends on
# any individual machine or contributor Git configuration.
#
# `eol=lf` rather than bare `text=auto` is deliberate: `text=auto` alone
# normalises the repository but leaves the working tree to each machine core.eol,
# which is CRLF on Windows.
* text=auto eol=lf

# Must be LF or they fail when executed on Linux/macOS.
*.sh   text eol=lf
*.bash text eol=lf

# Windows-only scripts must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# <<< eol-policy <<<
